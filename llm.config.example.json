{
  "$schema": "see docs/multi-llm.md",
  "providers": [
    {
      "name": "primary",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}",
      "model": "gpt-4.1-mini",
      "enabled": true
    },
    {
      "name": "local-qwen",
      "base_url": "http://host.container.internal:8001/v1",
      "api_key": "root",
      "model": "Qwen3.5-4B-MLX-4bit",
      "enabled": true
    }
  ],
  "chains": {
    "default": ["primary", "local-qwen"],
    "ontology": ["primary"],
    "simulation": ["local-qwen"],
    "report": ["primary"]
  }
}

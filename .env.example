# OpenReef / MiroFish environment — copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored. Never commit real keys.

# ---- LLM provider: pick ONE block ----

# Local model served by oMLX (https://omlx.ai) on this machine.
# OpenAI-compatible endpoint at http://localhost:8000/v1 (no key needed, or
# the key from oMLX settings.json). From inside a container the host is
# reachable via the special DNS name below (one-time setup for Apple
# containers; see docs/getting-started.md). OpenReef auto-detects local
# endpoints and adapts requests — see docs/local-models.md.
LLM_BASE_URL=http://host.container.internal:8000/v1
LLM_API_KEY=root
# Tested against MiroFish's real request shapes with the local adapter:
# Qwen3.5-4B-MLX-4bit produces complete, valid ontologies (~22s, rich output).
LLM_MODEL_NAME=Qwen3.5-4B-MLX-4bit

# Cloudflare Workers AI (OpenAI-compatible endpoint).
# Account ID: Cloudflare dashboard -> Workers AI -> "Use REST API".
# @cf/* names call Workers AI directly; openai/* names route through the
# default AI Gateway.
#LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_CF_ACCOUNT_ID/ai/v1
#LLM_API_KEY=YOUR_CF_API_TOKEN
#LLM_MODEL_NAME=@cf/google/gemma-4-26b-a4b-it

# ---- Graph memory ----
# Default is ReefMemory: built-in native memory (Graphiti + embedded Kuzu),
# data stored under uploads/reef-memory/, no external service or key needed.
# Set MEMORY_BACKEND=zep (and provide ZEP_API_KEY) only if you explicitly
# want legacy Zep Cloud.
#MEMORY_BACKEND=zep
ZEP_API_KEY=your_zep_api_key_here

# ---- "Boost" LLM config (optional; leave unset if unused) ----
# NOTE: do not include these keys in .env unless you actually use them.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ---- OpenReef local-model adapter (optional) ----
# Default auto: when LLM_BASE_URL points at a local endpoint (localhost,
# host.container.internal, *.local, ...), request adaptation activates
# automatically (root-object JSON schema, max_tokens cap 4096,
# repetition_penalty 1.05). See docs/local-models.md.
#OPENREEF_LOCAL_LLM=auto

# ---- OpenReef multi-LLM config (optional) ----
# With no config, behavior matches MiroFish exactly (single provider above).
# Recommended: create llm.config.json next to this file (copy
# llm.config.example.json); the run scripts mount it automatically. Enables
# per-stage model selection + automatic failover chains. Advanced (Docker):
# LLM_PROVIDERS_FILE / LLM_PROVIDERS_JSON env vars also work.
# See docs/multi-llm.md.
#LLM_PROVIDERS_FILE=/app/backend/llm.config.json

# ---- OpenReef agent web search (optional) ----
# Enables the per-simulation "agent web search" toggle (Step 2 UI).
# Free tier: 1000 searches/month. See docs/web-search.md.
#TAVILY_API_KEY=tvly-your-key-here

# ---- OpenReef ReefMemory embedder (optional) ----
# Embeddings default to the same provider as extraction; set these to serve
# embeddings elsewhere. Vector dimension is probed automatically at first
# use; set REEF_MEMORY_EMBEDDER_DIM to skip the probe.
# Example — oMLX serving embeddinggemma (port 8000, bypasses the chat shim):
#REEF_MEMORY_EMBEDDER_MODEL=embeddinggemma-2-8bit
#REEF_MEMORY_EMBEDDER_BASE_URL=http://host.container.internal:8000/v1
#REEF_MEMORY_EMBEDDER_API_KEY=root
#REEF_MEMORY_EMBEDDER_DIM=768

# ---- Browser -> backend routing ----
# The Vite dev server serves the UI to your browser; the browser then calls
# the backend at this address from the host, so it must be host-reachable
# (127.0.0.1 works because the backend port 5001 is published on the host
# loopback).
VITE_API_BASE_URL=http://127.0.0.1:5001

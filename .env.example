# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
# OpenReef: 默认使用内置 ReefMemory（Graphiti + 嵌入式 Kuzu，数据保存在
# uploads/reef-memory/，无需任何外部服务或密钥）。只有显式设置
# MEMORY_BACKEND=zep 时才需要下面的密钥。
#MEMORY_BACKEND=zep
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== OpenReef 多 LLM 配置（可选）=====
# 完全可选：不配置则行为与 MiroFish 完全一致（使用上面的 LLM_* 单提供方）。
# 推荐方式：在本文件同目录创建 llm.config.json（可复制 llm.config.example.json），
# 运行脚本会自动挂载进容器，支持按阶段选择不同模型 + 失败自动降级。
# 高级用法（Docker 场景）：也可用 LLM_PROVIDERS_FILE 指定任意路径，或
# LLM_PROVIDERS_JSON 内联 JSON。详见 docs/multi-llm.md
#LLM_PROVIDERS_FILE=/app/backend/llm.config.json

# ===== OpenReef 联网搜索（可选）=====
# 配置后可在模拟准备时开启 Agent 联网搜索（Tavily）。
# 免费额度每月 1000 次搜索。详见 docs/web-search.md
#TAVILY_API_KEY=tvly-your-key-here
